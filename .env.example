# Copy to .env for LOCAL backend testing only. NEVER commit the real .env.
# All values are optional; the backend runs in "unconfigured" mode without them.

# --- Inference providers (all have genuine zero-cost tiers; user supplies own key) ---
GOOGLE_AI_STUDIO_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Non-secret: which provider the backend should prefer
DEFAULT_PROVIDER=groq

# --- Backend security ---
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JARVIS_BACKEND_TOKEN=
# Comma-separated GitHub accounts allowed to OAuth (optional allowlist)
JARVIS_ALLOWED_GITHUB_USERS=

# --- OAuth apps (only needed for server-side OAuth flows; device flows work without) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- Storage / hosting hints (free tiers only) ---
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
